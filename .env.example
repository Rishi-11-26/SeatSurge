# SeatSurge Environment Variables Configuration
APP_ENV=production
PORT=8000
INSTANCE_ID=backend-1
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=seatsurge
POSTGRES_PASSWORD=seatsurge_secret
POSTGRES_DB=seatsurge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Security
SECRET_KEY=seatsurge-production-secure-random-secret-key-32chars
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
TRUSTED_PROXY_SUBNETS=["127.0.0.1/32","172.16.0.0/12","10.0.0.0/8","192.168.0.0/16"]

# Ticketing & Seat Parameters
HOLD_DURATION_SECONDS=120
REAPER_INTERVAL_SECONDS=5
MAX_GROUP_SEATS=6
TOTAL_SEATS=5040
